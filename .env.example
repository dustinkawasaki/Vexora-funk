# Discord credentials – keep the real values private in your host's secret settings.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID= # optional legacy fallback
OWNER_ROLE_IDS=
MODERATOR_ROLE_IDS=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
FUNK_CHANNEL_ID=
POLICE_ROLE_ID=
EMS_ROLE_ID=
FIRE_ROLE_ID=
TRUCKER_ROLE_ID=

# Only these Discord USER IDs may hire or dismiss roleplay employees.
VEXORA_DISPATCHER_IDS=

# Global VEXORA authorization: comma-separated Discord USER IDs (not role IDs).
VEXORA_DEVELOPER_IDS=
VEXORA_BOT_MODERATOR_IDS=

# Required to read per-server settings from the VEXORA dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
