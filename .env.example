# Discord Developer Portal credentials. Never commit your real .env file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord ROLE IDS (not role names or nicknames).
OWNER_ROLE_IDS=
MODERATOR_ROLE_IDS=

# Private staff channel for audit and moderation alerts.
LOG_CHANNEL_ID=

# Optional comma-separated terms to flag for human review. No automatic punishment.
BLOCKED_TERMS=
